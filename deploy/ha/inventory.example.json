{
  "cluster": "sub2api",
  "postgres_bin_dir": "/usr/lib/postgresql/17/bin",
  "nodes": [
    {
      "id": "us",
      "private_ip": "10.70.0.1",
      "kind": "application"
    },
    {
      "id": "hk",
      "private_ip": "10.70.0.2",
      "kind": "application"
    },
    {
      "id": "witness",
      "private_ip": "10.70.0.3",
      "kind": "witness"
    }
  ],
  "capacity": {
    "database_max_connections": 300,
    "database_reserved_connections": 60,
    "database_per_node": 80,
    "redis_max_clients": 4096,
    "redis_pool_per_node": 256,
    "requests_per_node": 1000
  },
  "ingress": {
    "domain": "api.example.com",
    "endpoints": [
      {
        "id": "us",
        "ip": "192.0.2.10"
      },
      {
        "id": "hk",
        "ip": "192.0.2.20"
      }
    ]
  }
}
