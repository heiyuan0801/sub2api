# Add to the existing installation; retain its original DB/Redis/JWT/TOTP values.
CLUSTER_ENABLED=true
CLUSTER_NODE_ID=us-primary
CLUSTER_ROLE=primary
CLUSTER_DRAIN_SECONDS=10
CLUSTER_SHUTDOWN_TIMEOUT_SECONDS=120
CLUSTER_BILLING_FAILURE_MODE=closed
# Bind only to the private tunnel, never the public NIC.
SERVER_HOST=10.70.0.1
SERVER_PORT=8080
SERVER_TRUSTED_PROXIES=10.70.0.2/32
SECURITY_TRUST_FORWARDED_IP_FOR_API_KEY_ACL=false
# Do not use newly generated JWT_SECRET / TOTP_ENCRYPTION_KEY.
# Existing config.yaml can provide DATABASE_*, REDIS_*, JWT_SECRET and
# TOTP_ENCRYPTION_KEY. Both nodes must use identical existing values.
